// Returns & exchanges platform — PostgreSQL schema.
//
// Multi-tenant: every row that belongs to a store carries `merchantId`, and
// every query in the service layer is scoped by it. Money is stored as
// Decimal(12,2) with a sibling currency column; never as float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & staff
// ---------------------------------------------------------------------------

model Merchant {
  id                        String                    @id @default(cuid())
  // URL-safe identifier used in portal links: /r/:slug
  slug                      String                    @unique
  name                      String
  // Storefront domain, e.g. acme.myshopify.com or shop.acme.com
  domain                    String?                   @unique
  email                     String?
  currency                  String                    @default("USD")
  /**
   * How exchanges are fulfilled in Shopify. The two paths trade off against
   * each other and neither is strictly better — see ExchangeMethod.
   */
  exchangeMethod            ExchangeMethod            @default(DRAFT_ORDER)
  /**
   * Which currency the app *shows*, independent of what it stores.
   * All arithmetic stays in shop currency; this only affects presentation.
   * PRESENTMENT converts using each order's own rate — presentment total over
   * shop total — so figures match what the customer was actually charged
   * rather than a rate invented at display time.
   */
  displayCurrency           DisplayCurrency           @default(SHOP)
  /**
   * "Shop now" — offering the return's value as credit to spend on anything in
   * the catalogue, rather than swapping one item for another.
   * Off by default, and deliberately so: turning it on changes what the portal
   * offers every shopper, which is the merchant's decision to make rather than
   * something that should appear because they upgraded.
   */
  shopNowEnabled            Boolean                   @default(false)
  shopNowMode               ShopNowMode               @default(RETURNS_PAGE)
  /**
   * A flat sweetener on top of the policy's percentage bonus, e.g. "$15 extra
   * if you spend it with us". Stored in shop currency like every other figure.
   * Null means no flat bonus; the percentage still applies.
   */
  shopNowBonusAmount        Decimal?                  @db.Decimal(12, 2)
  /// Whether shopNowBonusAmount is a flat sum or a percentage of the return.
  shopNowBonusType          BonusType                 @default(FIXED)
  /**
   * The sweetener for exchanging rather than taking the money — a size swap or
   * one of the merchant's advanced-exchange lists.
   * Null falls back to the policy's bonusCreditPercent, which is what applied
   * before this existed, so a store that never opens the page is unaffected.
   * A FIXED bonus is per return, not per line: a flat 10 EUR is an incentive
   * to exchange, not a multiplier on how many items came back.
   */
  exchangeBonusType         BonusType                 @default(PERCENT)
  exchangeBonusValue        Decimal?                  @db.Decimal(12, 2)
  /**
   * What to do when a size swap isn't worth exactly what came back.
   * Separate from "shop now", which is about spending a return's value on
   * purpose. This is about the gap that appears when a shopper wanted the same
   * item in another size and the two aren't priced identically — often not a
   * real difference at all, but the order's historical exchange rate meeting
   * today's catalogue price.
   */
  variantExchangeDifference VariantExchangeDifference @default(CHARGE)
  /**
   * The name customers see in their inbox, when the store wants one other
   * than its own. Null means the merchant's name, which is what every
   * notification used before this was configurable.
   * Only the name: the address itself stays on the platform's verified
   * sending domain, because a From on a domain we can't sign for is the
   * fastest way into a spam folder. The merchant's support address travels
   * as Reply-To instead, so a customer hitting reply still reaches them.
   */
  senderName                String?

  timezone  String         @default("UTC")
  status    MerchantStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  branding             PortalBranding?
  memberships          Membership[]
  policies             ReturnPolicy[]
  reasons              ReturnReason[]
  exchangeRules        ExchangeRule[]
  notificationSettings NotificationSetting[]
  reasonGroups         ReturnReasonGroup[]
  orders               Order[]
  returnRequests       ReturnRequest[]
  storeCredits         StoreCredit[]
  integrations         Integration[]

  @@map("merchants")
}

/**
 * Which mechanism creates the replacement for an exchange.
 * DRAFT_ORDER reserves the replacement stock the moment the return is
 * approved, so a popular size can't sell out while the parcel is in transit,
 * and any balance is collected through a normal checkout link. The cost is
 * that the exchange is a second order, so it doesn't net against the original
 * in Shopify's own reporting.
 * SHOPIFY_NATIVE puts the replacement on the original order via
 * `exchangeLineItems`, so revenue nets correctly and Shopify holds fulfillment
 * until any balance is paid. The cost is that nothing commits until
 * `returnProcess` runs — days later — so the stock is unreserved until then.
 */
enum ExchangeMethod {
  DRAFT_ORDER
  SHOPIFY_NATIVE
}

/**
 * "Advanced exchanges": what a shopper may swap a given item *for*.
 * Without a rule, an exchange offers the item's own other variants and the
 * whole catalogue. A rule narrows that: returned items matching it are offered
 * one or more named lists, each backed by a collection — "exchange for a new
 * style", "pre-order", "clearance" — so the merchant decides what a return can
 * turn into rather than leaving it open.
 * Matching is against a snapshot taken when the order synced, not against the
 * product as it stands today. A shopper's options shouldn't change because
 * someone retagged a product last week.
 */
model ExchangeRule {
  id                String            @id @default(cuid())
  merchantId        String
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// The merchant's own label, e.g. "department:footwear, brand:alohas".
  name              String
  active            Boolean           @default(true)
  /// First match wins, so a specific rule can sit above a catch-all.
  sortOrder         Int               @default(0)
  matchBy           ExchangeRuleMatch @default(PRODUCT_TAG)
  /// Tags, or fragments of a product title, that identify a returned item.
  matchValues       String[]
  /// Whether the shopper sees names under the pictures, or just the pictures.
  showProductTitles Boolean           @default(false)
  /**
   * A sweetener specific to this rule, overriding the store-wide exchange
   * bonus for the items it matches — "10% extra for swapping footwear".
   * Null value means no override. Where several rules match one item, the
   * first that sets a bonus wins, by the merchant's own ordering: the
   * alternative of summing them would hand a shopper more credit the more
   * rules happened to overlap, which nobody intends.
   */
  bonusType         BonusType?
  bonusValue        Decimal?          @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  options ExchangeRuleOption[]

  @@index([merchantId, active, sortOrder])
  @@map("exchange_rules")
}

enum ExchangeRuleMatch {
  /// The returned product carries one of the listed tags.
  PRODUCT_TAG
  /// The returned product's title contains one of the listed fragments.
  PRODUCT_NAME
}

/**
 * One named list a matching item may be exchanged into.
 */
model ExchangeRuleOption {
  id              String       @id @default(cuid())
  ruleId          String
  rule            ExchangeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// What the shopper reads, e.g. "Exchange for a new style".
  label           String
  /// The Shopify collection this option draws from.
  collectionId    String
  /// Kept alongside the id so the admin can name it without a round trip.
  collectionTitle String
  sortOrder       Int          @default(0)

  @@index([ruleId, sortOrder])
  @@map("exchange_rule_options")
}

/**
 * How a price gap between two variants of the same product is settled.
 */
enum VariantExchangeDifference {
  /// Only variants of equal value are offered, so no gap can arise.
  SAME_PRICE_ONLY
  /// The shopper pays what's owed, or is credited what's left over.
  CHARGE
  /// The merchant covers it: the shopper pays nothing and is owed nothing.
  ABSORB
}

/**
 * How a credit bonus is expressed.
 */
enum BonusType {
  /// A share of what came back, e.g. 10%.
  PERCENT
  /// A flat sum in shop currency, e.g. 10 EUR, added once per return.
  FIXED
}

/**
 * Where a shopper spends their return credit under "shop now".
 */
enum ShopNowMode {
  /// In the portal itself: catalogue, cart and checkout without leaving.
  RETURNS_PAGE
  /// Bounced to the merchant's own storefront to shop, then back to finish.
  STOREFRONT
}

enum DisplayCurrency {
  /// The merchant's own books, e.g. EUR.
  SHOP
  /// What the customer was charged, e.g. INR. Per order.
  PRESENTMENT
}

/**
 * How a trade-down's leftover value reaches the shopper.
 */
enum ExchangeSurplusMethod {
  REFUND
  STORE_CREDIT
  GIFT_CARD
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

/**
 * A person, not a person-at-a-store.
 * Merchants routinely run several Shopify stores, and one login should reach
 * all of them. The store a request acts on comes from the session token rather
 * than from this row, which is what keeps every service unchanged: they still
 * receive a merchantId, it is simply chosen at sign-in instead of being fixed
 * to the account.
 */
model User {
  id           String    @id @default(cuid())
  /// Globally unique now: one person, one account, however many stores.
  email        String    @unique
  passwordHash String
  name         String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships     Membership[]
  reviewedReturns ReturnRequest[] @relation("ReviewedBy")
  events          ReturnEvent[]

  @@map("users")
}

/**
 * One person's access to one store, and the role they hold there.
 * Role lives here rather than on the user because it is genuinely per store:
 * someone can own the shop they founded and be an agent on a colleague's.
 */
model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  role       UserRole @default(AGENT)
  createdAt  DateTime @default(now())

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@map("memberships")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

// ---------------------------------------------------------------------------
// Portal configuration — what the shopper sees and what they're allowed to do
// ---------------------------------------------------------------------------

model PortalBranding {
  id           String   @id @default(cuid())
  merchantId   String   @unique
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  headline     String   @default("Returns & Exchanges")
  subheadline  String   @default("Start a return or exchange in a few clicks")
  logoUrl      String?
  /// Full-bleed image behind the portal. Merchant-set; when null the app
  /// borrows a product photo from the store's own catalogue and caches it here.
  heroImageUrl String?
  accentColor  String   @default("#111213")
  supportEmail String?
  policyUrl    String?
  updatedAt    DateTime @updatedAt

  @@map("portal_branding")
}

/// A merchant can run several policies (e.g. standard, final-sale, holiday)
/// and pick which one applies to an order. `isDefault` is the fallback.
model ReturnPolicy {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)

  // Eligibility
  returnWindowDays  Int         @default(30)
  // Window is measured from this event
  windowStartsFrom  WindowStart @default(DELIVERY)
  allowFinalSale    Boolean     @default(false)
  requirePhotoProof Boolean     @default(false)

  // Which resolutions the portal offers
  allowRefund          Boolean @default(true)
  allowStoreCredit     Boolean @default(true)
  allowGiftCard        Boolean @default(false)
  allowExchange        Boolean @default(true)
  // Ship the replacement before the original comes back (Loop's instant exchange)
  allowInstantExchange Boolean @default(false)

  // Incentive to choose credit over cash, as a percentage of item value
  bonusCreditPercent Decimal @default(0) @db.Decimal(5, 2)

  // Fees deducted from the refund
  restockingFeePercent  Decimal @default(0) @db.Decimal(5, 2)
  returnShippingFee     Decimal @default(0) @db.Decimal(12, 2)
  // Waive the return shipping fee when the shopper takes credit or an exchange
  waiveShippingOnCredit Boolean @default(true)

  // Requests under this value skip manual review
  autoApprove      Boolean  @default(false)
  autoApproveUnder Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  returnRequests ReturnRequest[]

  @@index([merchantId])
  @@map("return_policies")
}

enum WindowStart {
  ORDER_DATE
  FULFILLMENT
  DELIVERY
}

/// A set of reasons offered for a particular kind of product.
///
/// Merchants word returns differently for footwear than for homeware, so the
/// portal picks a group per line item from the product's type. Exactly one
/// group per merchant is the default, catching everything unclaimed.
model ReturnReasonGroup {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// Internal name; never shown to shoppers.
  title          String
  /// Shopify product types this group claims, matched case-insensitively.
  productTypes   String[] @default([])
  /// Shuffle the order per shopper, so position stops biasing the answer —
  /// merchants use this to stop "Too small" absorbing every ambiguous return.
  randomizeOrder Boolean  @default(false)
  /// The fallback for products no other group claims.
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reasons ReturnReason[]

  @@index([merchantId])
  @@map("return_reason_groups")
}

/// Reasons are per-merchant so stores can word them their own way.
///
/// Two levels: a parent is what the shopper picks first ("I received the wrong
/// item"), a child narrows it ("Right item, but in the wrong size"). Only
/// leaves are selectable, which is what makes the answers worth reporting on.
///
/// `code` is the mapping onto Shopify's fixed ReturnReason enum and is
/// deliberately NOT unique — several differently-worded reasons legitimately
/// report as WRONG_ITEM.
model ReturnReason {
  id         String             @id @default(cuid())
  merchantId String
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  groupId    String?
  group      ReturnReasonGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Null for a top-level reason.
  parentId   String?
  parent     ReturnReason?      @relation("ReasonTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   ReturnReason[]     @relation("ReasonTree")

  code          String
  label         String
  // Force the shopper to explain (e.g. "Other", "Damaged")
  requiresNote  Boolean @default(false)
  requiresPhoto Boolean @default(false)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  returnLineItems ReturnLineItem[]

  @@index([merchantId])
  @@index([groupId])
  @@index([parentId])
  @@map("return_reasons")
}

// ---------------------------------------------------------------------------
// Commerce data — mirrored from the storefront platform
// ---------------------------------------------------------------------------

model Order {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyId   String?
  policy     ReturnPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  // Identifier on the source platform (Shopify order GID, etc.)
  externalId          String?
  /// The Shopify Customer GID. Needed to credit a store credit account, which
  /// is keyed on the customer rather than the order.
  customerExternalId  String?
  // Human-facing number the shopper types in, e.g. "1001"
  orderNumber         String
  email               String
  customerName        String?
  /// Shop currency — the merchant's own books. All our line-item maths uses this.
  currency            String    @default("USD")
  subtotal            Decimal   @default(0) @db.Decimal(12, 2)
  total               Decimal   @default(0) @db.Decimal(12, 2)
  /// The currency the customer was actually charged in. Differs from `currency`
  /// on multi-currency stores, and is what store credit must be denominated in
  /// for the customer to be able to spend it.
  presentmentCurrency String?
  /// Order total in the presentment currency, used to derive the rate that
  /// converts a payout from shop currency into what the customer paid.
  presentmentTotal    Decimal?  @db.Decimal(12, 2)
  placedAt            DateTime
  fulfilledAt         DateTime?
  deliveredAt         DateTime?
  shippingAddress     Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lineItems      OrderLineItem[]
  returnRequests ReturnRequest[]

  @@unique([merchantId, orderNumber])
  @@unique([merchantId, externalId])
  @@index([merchantId, email])
  @@map("orders")
}

model OrderLineItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  externalId       String?
  productId        String?
  variantId        String?
  sku              String?
  /// Shopify's product type, used to pick which reason group applies.
  productType      String?
  title            String
  variantTitle     String?
  /// The product's tags when the order synced. A snapshot on purpose: advanced
  /// exchange rules match on these, and retagging a product later shouldn't
  /// silently change what an existing order may be exchanged for.
  productTags      String[]
  /// The option axis this variant sits on, e.g. [{name:"Size",value:"37"}].
  /// Shopify's variantTitle carries only the values — "37", or "Blue / M" —
  /// so without the names the portal can only print a bare number at the
  /// shopper and hope they recognise it.
  variantOptions   Json?
  imageUrl         String?
  quantity         Int      @default(1)
  // Per-unit price after line discounts
  unitPrice        Decimal  @default(0) @db.Decimal(12, 2)
  currency         String   @default("USD")
  // Excluded from returns entirely
  finalSale        Boolean  @default(false)
  // Units already returned across all requests; returnable = quantity - returnedQuantity
  returnedQuantity Int      @default(0)

  returnLineItems ReturnLineItem[]

  // Lets a re-synced order upsert its lines instead of duplicating them.
  @@unique([orderId, externalId])
  @@index([orderId])
  @@map("order_line_items")
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model ReturnRequest {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  policyId   String?
  policy     ReturnPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  /// Short human-readable reference shown to the shopper, e.g. "R-7F3K2Q"
  /**
   * /**
   * Merchant-facing, and unique per merchant rather than globally.
   * Six characters from a 29-letter alphabet is ~594 million combinations,
   * which sounds ample until the birthday bound: a global constraint would hit
   * a coin-flip chance of collision at roughly 24,000 returns across every
   * store on the platform, and a collision fails a shopper's submission. Scoped
   * per merchant, that threshold applies to one store's own returns instead.
   */
  reference             String
  status                ReturnStatus          @default(SUBMITTED)
  resolution            ResolutionType
  /**
   * Where the surplus goes when an exchange is worth less than what came back.
   * A trade-down leaves the shopper owed money, and that money deserves the
   * same choice a plain refund gets. Kept apart from `resolution` because an
   * exchange line's resolution is already EXCHANGE — this answers a different
   * question about the leftover.
   */
  exchangeSurplusMethod ExchangeSurplusMethod @default(REFUND)
  /**
   * The shopper spent their return value in the catalogue rather than swapping
   * item for item.
   * Recorded on the request because it changes how the money is worked out: a
   * per-item exchange nets each line against its own replacement, while this
   * pools every line's credit against one basket. Without the flag there is no
   * way to tell the two apart after the fact — both end up as EXCHANGE lines
   * with ExchangeItems hanging off them.
   */
  shopNow               Boolean               @default(false)
  /// The flat bonus that applied at submission, kept so a later settings change
  /// can't silently restate what the shopper was promised.
  shopNowBonus          Decimal               @default(0) @db.Decimal(12, 2)

  customerEmail String
  customerName  String?
  customerNote  String?

  // Money breakdown, all in `currency`
  currency       String   @default("USD")
  /// Value of the returned items before any adjustments
  itemsSubtotal  Decimal  @default(0) @db.Decimal(12, 2)
  /// Extra credit granted as an incentive (store credit / exchange only)
  bonusCredit    Decimal  @default(0) @db.Decimal(12, 2)
  restockingFee  Decimal  @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal  @default(0) @db.Decimal(12, 2)
  /// itemsSubtotal + bonusCredit - restockingFee - shippingFee
  estimatedTotal Decimal  @default(0) @db.Decimal(12, 2)
  /// What was actually paid out once resolved
  settledTotal   Decimal? @db.Decimal(12, 2)

  /// The Return object created on the Shopify order (gid://shopify/Return/...).
  /// Set when the return is approved; null until then, or if Shopify rejected it.
  externalReturnId String?
  /// Shopify's own status for that Return (OPEN, CLOSED, DECLINED...), which
  /// moves independently of our internal status.
  externalStatus   String?
  /// Populated when returnProcess issues the refund, for reconciliation.
  externalRefundId String?

  /**
   * Merchant flag for a return that needs a second look.
   * Deliberately orthogonal to status: flagging is a note to the team, not a
   * decision, so a flagged return keeps moving through the same states.
   */
  flaggedAt  DateTime?
  flagReason String?

  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  /**
   * When the two nudges went out, so the sweep that sends them can't send
   * them twice.
   *
   * On the request rather than inferred from the timeline: "have we already
   * reminded this shopper" is a question asked on every pass over every open
   * return, and reading it off an event log would mean scanning one.
   */
  reminderSentAt  DateTime?
  expiringSentAt  DateTime?

  submittedAt DateTime  @default(now())
  receivedAt  DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lineItems     ReturnLineItem[]
  exchangeItems ExchangeItem[]
  shipment      ReturnShipment?
  storeCredit   StoreCredit?
  events        ReturnEvent[]
  feedback      ReturnFeedback?
  exchangeDraft ExchangeDraftOrder?

  @@unique([merchantId, reference])
  @@index([merchantId, status])
  @@index([merchantId, submittedAt])
  @@index([orderId])
  @@map("return_requests")
}

enum ReturnStatus {
  /// Shopper started but hasn't submitted
  DRAFT
  /// Awaiting merchant review
  SUBMITTED
  APPROVED
  REJECTED
  /// Shopper has shipped the items back
  IN_TRANSIT
  /// Items arrived at the warehouse
  RECEIVED
  /// Refund issued / credit granted / exchange shipped
  RESOLVED
  CANCELLED
  /// Approved but the shopper never sent the items
  EXPIRED
}

enum ResolutionType {
  REFUND
  STORE_CREDIT
  EXCHANGE
  /// A Shopify gift card, spendable by anyone holding the code
  GIFT_CARD
  /// Replacement ships immediately, before the return is received
  INSTANT_EXCHANGE
  WARRANTY
}

model ReturnLineItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderLineItemId String
  orderLineItem   OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)
  reasonId        String?
  reason          ReturnReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)

  /// How *this item* is being compensated.
  ///
  /// Resolution lives per line, not per return: a shopper can exchange one item
  /// for a different size, refund a second and take credit on a third, all in
  /// one request. ReturnRequest.resolution remains as a summary of the mix, for
  /// list views and reporting.
  resolution ResolutionType @default(REFUND)

  quantity                 Int               @default(1)
  reasonNote               String?
  /// Shopify's FulfillmentLineItem id, resolved from returnableFulfillments at
  /// approval time. This — not the LineItem id — is what returnCreate needs.
  fulfillmentLineItemId    String?
  /// The ReturnLineItem Shopify created, needed later by returnProcess.
  externalReturnLineItemId String?
  /// URLs of shopper-uploaded condition photos
  photoUrls                String[]          @default([])
  unitPrice                Decimal           @default(0) @db.Decimal(12, 2)
  /// unitPrice * quantity
  lineTotal                Decimal           @default(0) @db.Decimal(12, 2)
  /// Set by the warehouse when the item is inspected
  inspection               InspectionResult?

  /**
   * How many of the requested units the merchant actually accepted.
   * Null until someone inspects the line. Once set, this — not `quantity` —
   * drives what gets refunded and what gets restocked, so a shopper who sends
   * back six and has four accepted is paid for four.
   */
  acceptedQuantity Int?
  /// Whether accepted units go back on the shelf or are written off. Maps to
  /// Shopify's RESTOCKED / NOT_RESTOCKED disposition, which is one-shot per
  /// unit and can't be changed afterwards.
  restock          Boolean @default(true)
  /// Shown to nobody but the merchant; explains a partial or full rejection.
  rejectionNote    String?
  /**
   * "Change to keep": the shopper is credited but keeps the goods.
   * Used when return shipping costs more than the item is worth, or the item
   * is unsellable anyway. Nothing physically comes back, so these lines are
   * never disposed in Shopify — but they still pay out.
   */
  keepItem         Boolean @default(false)

  /// What the shopper chose instead, when this line is an exchange.
  exchangeItems ExchangeItem[]

  @@index([returnRequestId])
  @@map("return_line_items")
}

enum InspectionResult {
  PENDING
  ACCEPTED
  DAMAGED
  WRONG_ITEM
  REJECTED
}

/// What the shopper wants instead, for EXCHANGE / INSTANT_EXCHANGE.
model ExchangeItem {
  id               String          @id @default(cuid())
  returnRequestId  String
  returnRequest    ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  /// The returned line this replaces. Nullable only for exchanges created
  /// before resolutions moved per-line.
  returnLineItemId String?
  returnLineItem   ReturnLineItem? @relation(fields: [returnLineItemId], references: [id], onDelete: Cascade)

  productId                  String?
  variantId                  String?
  sku                        String?
  title                      String
  /// Already named where it's set, e.g. "Size: 37" — the portal labels a chosen
  /// variant before storing it, so there is no second field to carry here.
  variantTitle               String?
  imageUrl                   String?
  /// The ExchangeLineItem Shopify created, which `returnProcess` needs to
  /// confirm the exchange. Only set on the SHOPIFY_NATIVE path.
  externalExchangeLineItemId String?
  quantity                   Int     @default(1)
  unitPrice                  Decimal @default(0) @db.Decimal(12, 2)
  /// Amount the shopper still owes when the swap costs more
  priceDifference            Decimal @default(0) @db.Decimal(12, 2)

  @@index([returnRequestId])
  @@map("exchange_items")
}

model ReturnShipment {
  id              String        @id @default(cuid())
  returnRequestId String        @unique
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  status         ShipmentStatus @default(PENDING)
  /// Cost of the label, for merchant reporting
  labelCost      Decimal?       @db.Decimal(12, 2)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("return_shipments")
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model StoreCredit {
  id              String         @id @default(cuid())
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  /// Distinguishes a store credit balance from a gift card.
  kind                  CreditKind @default(STORE_CREDIT)
  /// For gift cards this is the real, redeemable Shopify code. For store credit
  /// it is a legacy internal reference with no meaning at checkout.
  code                  String     @unique
  /// The Shopify StoreCreditAccount this was credited to, when applicable.
  externalAccountId     String?
  /// The Shopify credit transaction, for reconciliation.
  externalTransactionId String?
  customerEmail         String
  amount                Decimal    @db.Decimal(12, 2)
  balance               Decimal    @db.Decimal(12, 2)
  currency              String     @default("USD")
  expiresAt             DateTime?
  createdAt             DateTime   @default(now())

  @@index([merchantId, customerEmail])
  @@map("store_credits")
}

enum CreditKind {
  STORE_CREDIT
  GIFT_CARD
}

/// Append-only timeline shown on the return detail page.
model ReturnEvent {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  type      ReturnEventType
  message   String
  /// Arbitrary context: status transitions, API payloads, etc.
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([returnRequestId, createdAt])
  @@map("return_events")
}

/// The survey on the shopper's confirmation page.
///
/// One row per return rather than one per submission: a shopper who changes a
/// score and submits again should correct their answer, not be counted twice.
model ReturnFeedback {
  id              String        @id @default(cuid())
  returnRequestId String        @unique
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  /// "How was your returns experience?" — 1 very difficult, 5 very easy.
  easeScore   Int?
  /// "How likely are you to buy from us again?" — 1 not likely, 5 very likely.
  repeatScore Int?
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("return_feedback")
}

/// The Shopify draft order that carries a return's exchange.
///
/// One draft per return, not per item: everything the shopper is swapping into
/// goes on the same draft so they get a single invoice for whatever they still
/// owe, and a single replacement order to fulfil.
///
/// Creating it early is the point of using draft orders at all — it reserves
/// the replacement stock while the returned parcel is still in transit, which
/// Shopify's native exchange path can't do (it only commits at returnProcess).
model ExchangeDraftOrder {
  id              String        @id @default(cuid())
  returnRequestId String        @unique
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  /// gid://shopify/DraftOrder/...
  externalId String
  /// Merchant-facing name Shopify assigns, e.g. "#D12".
  name       String?
  /// Secure checkout link the shopper pays through.
  invoiceUrl String?
  /// Mirrors Shopify's own DraftOrderStatus so the admin doesn't need a round
  /// trip to render the return.
  status     ExchangeDraftStatus @default(OPEN)

  /// Shop currency. The draft is deliberately not opened in the customer's
  /// presentment currency — see the note on issueShopifyGiftCard for why
  /// converting money we compute ourselves is a trap.
  currency      String
  /// Catalogue value of the replacement items, before the return credit.
  itemsTotal    Decimal @default(0) @db.Decimal(12, 2)
  /// The returned items' value, applied to the draft as an order discount.
  creditApplied Decimal @default(0) @db.Decimal(12, 2)
  /// What the shopper still owes. Zero for an even or trade-down exchange.
  balanceDue    Decimal @default(0) @db.Decimal(12, 2)

  /// When Shopify releases the reserved stock if the exchange never completes.
  reservedUntil   DateTime?
  invoiceSentAt   DateTime?
  /// gid://shopify/Order/... once the draft becomes a real order.
  externalOrderId String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalId])
  @@map("exchange_draft_orders")
}

enum ExchangeDraftStatus {
  OPEN
  INVOICE_SENT
  COMPLETED
  CANCELLED
}

enum ReturnEventType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  LABEL_GENERATED
  ITEM_INSPECTED
  REFUND_ISSUED
  CREDIT_ISSUED
  EXCHANGE_SHIPPED
  EMAIL_SENT
}

// ---------------------------------------------------------------------------
// Platform integrations (Shopify first, others later)
// ---------------------------------------------------------------------------

model Integration {
  id             String              @id @default(cuid())
  merchantId     String
  merchant       Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  provider       IntegrationProvider
  /// Encrypted at rest by the service layer before it lands here
  accessToken    String?
  scopes         String?
  externalShopId String?
  connectedAt    DateTime            @default(now())
  lastSyncedAt   DateTime?
  active         Boolean             @default(true)

  @@unique([merchantId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  CUSTOM
}

/**
 * Which lifecycle emails a store sends.
 * A row is only written when a merchant changes something, so the absence of
 * one means "on". That way a store that has never opened this page keeps
 * sending exactly what it sent before, and a notification added later is on
 * by default rather than silently disabled for everyone.
 */
model NotificationSetting {
  id         String           @id @default(cuid())
  merchantId String
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  enabled    Boolean          @default(true)
  updatedAt  DateTime         @updatedAt

  @@unique([merchantId, kind])
  @@map("notification_settings")
}

/// The lifecycle moments the app emails a customer about.
enum NotificationKind {
  SUBMITTED
  APPROVED
  DECLINED
  /// A merchant changed what's being accepted, so the payout moved.
  EDITED
  RECEIVED
  RESOLVED
  /// Approved a while ago and still nothing sent back.
  REMINDER
  /// The same, later, warning that the request is about to close.
  EXPIRING
  /// It closed.
  EXPIRED
}
