# Copy to .env and adjust. Both workspaces read from this root file.

NODE_ENV=development

# --- Database ---
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql://returns:returns@localhost:5433/returns?schema=public

# --- Server ---
PORT=4000

# How often the reminder sweep runs, in minutes. It chases returns that were
# approved and never arrived, and closes them if the store has asked for that.
# Set to 0 on any second instance: two servers sweeping one database would send
# every reminder twice.
REMINDER_SWEEP_MINUTES=60
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Secret used to sign merchant admin sessions and shopper portal tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# How long a shopper's portal session (after order lookup) stays valid
PORTAL_TOKEN_TTL_MINUTES=60

# --- Shopify ---
# Public HTTPS origin Shopify redirects to and posts webhooks at.
# Locally this must be a tunnel (e.g. `cloudflared tunnel --url http://localhost:4000`),
# NOT localhost — Shopify cannot reach your machine otherwise.
APP_URL=http://localhost:4000
# From your app in the Shopify Partner Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments,read_products,read_customers,write_customers,read_returns,write_returns,read_locations,read_store_credit_accounts,read_store_credit_account_transactions,write_store_credit_account_transactions,read_gift_cards,write_gift_cards,read_draft_orders,write_draft_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders
SHOPIFY_API_VERSION=2026-04
# Encrypts Shopify access tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Email ---
# Leave SMTP_HOST blank in development: emails are written to server/.mail/
# as HTML files instead of being sent, so you can read them without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
MAIL_FROM=Returns <returns@example.com>
# Where customer-facing links point. Defaults to the first CORS origin.
PORTAL_BASE_URL=http://localhost:5173

# --- Client ---
VITE_API_URL=http://localhost:4000
