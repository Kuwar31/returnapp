# Copy to .env and adjust. Both workspaces read from this root file.

NODE_ENV=development

# --- Database ---
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql://returns:returns@localhost:5433/returns?schema=public

# --- Server ---
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Secret used to sign merchant admin sessions and shopper portal tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# How long a shopper's portal session (after order lookup) stays valid
PORTAL_TOKEN_TTL_MINUTES=60

# --- Shopify ---
# Public HTTPS origin Shopify redirects to and posts webhooks at.
# Locally this must be a tunnel (e.g. `cloudflared tunnel --url http://localhost:4000`),
# NOT localhost — Shopify cannot reach your machine otherwise.
APP_URL=http://localhost:4000
# From your app in the Shopify Partner Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments,read_products,read_customers
SHOPIFY_API_VERSION=2026-04
# Encrypts Shopify access tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Client ---
VITE_API_URL=http://localhost:4000
